# Copie para .env no VPS (nunca commitar .env com segredos)
NODE_ENV=production
PORT=8787

# Obrigatório em produção — gere uma string longa aleatória
CVL_SESSION_SECRET=

# Opcional: pasta persistente para SQLite/uploads/contratos
# CVL_DATA_DIR=/var/lib/cvl-crm

# IA — teste com a mesma forge do ImprimeMais (depois o amigo troca)
# Copie do .env / Hostinger do app.imprimemais (não commitar valores):
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Ou chave própria:
CVL_AI_API_KEY=
# CVL_AI_BASE_URL=https://api.openai.com/v1
# CVL_AI_MODEL=gpt-4o-mini
# Com forge, o padrão de modelo é gemini-flash-lite-latest
