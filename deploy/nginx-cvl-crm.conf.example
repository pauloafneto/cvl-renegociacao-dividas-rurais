# Exemplo nginx — Hostinger VPS
# Ajuste o server_name para o subdomínio da demo (ex.: cvl-crm.seudominio.com.br)
# Proxy para o Node (PM2) na porta 8787.

server {
    listen 80;
    server_name cvl-crm.seudominio.com.br;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Depois do SSL (certbot ou hPanel):
# listen 443 ssl;
# ssl_certificate ...;
# ssl_certificate_key ...;
